# --- Core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://snap.yourdomain.com
TIME_ZONE=UTC

# --- Database (default: sqlite file) ---
# DATABASE_URL=sqlite:///db.sqlite3

# --- Storage: local media in dev, S3 in prod ---
USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ENDPOINT_URL=            # only for S3-compatible providers (R2, MinIO, etc.)

# --- Email: console backend in dev prints to terminal ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Prod Gmail SMTP (use a Google App Password, NOT your normal password):
#   https://myaccount.google.com/apppasswords
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-app-password
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Quick Snap <you@gmail.com>

# --- Monitoring ---
# Bearer token guarding GET /metrics. Leave blank in dev (the endpoint is open
# when DEBUG=True); in production an empty value makes /metrics 404 (fail
# closed). deploy.sh generates one automatically on first deploy.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
METRICS_TOKEN=

# Grafana is published at https://<domain>/grafana/ — this password is the only
# thing in front of it, so make it long and random. deploy.sh refuses to deploy
# while it is unset.
GRAFANA_DOMAIN=alialiabadi.ir
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
